---
import { site } from "../config/site";
import { getContent } from "../i18n";
import Button from "./ui/Button.astro";
import Logo from "./ui/Logo.astro";

const t = getContent();
---

<header class="site-header" data-header>
	<div class="container bar">
		<a href="/" class="home" aria-label={t.a11y.home}><Logo /></a>

		<nav class="nav" aria-label={t.a11y.mainNav}>
			<ul role="list" class="nav-list">
				{
					t.nav.items.map((item) => (
						<li>
							<a href={item.href}>{item.label}</a>
						</li>
					))
				}
			</ul>
		</nav>

		<div class="actions">
			<Button href={site.loginUrl} variant="ghost" class="login">{t.nav.login}</Button>
			<Button href={site.signupUrl} class="signup">{t.nav.signup}</Button>
			<button
				type="button"
				class="menu-toggle"
				aria-expanded="false"
				aria-controls="mobile-menu"
				data-menu-toggle
				data-label-open={t.a11y.openMenu}
				data-label-close={t.a11y.closeMenu}
			>
				<span class="visually-hidden" data-menu-label>{t.a11y.openMenu}</span>
				<svg class="icon-open" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
					<path d="M4 8h16M4 16h16"></path>
				</svg>
				<svg class="icon-close" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
					<path d="m6 6 12 12M18 6 6 18"></path>
				</svg>
			</button>
		</div>
	</div>

	<div id="mobile-menu" class="mobile-menu" hidden data-menu>
		<nav class="container" aria-label={t.a11y.mainNav}>
			<ul role="list">
				{
					t.nav.items.map((item) => (
						<li>
							<a href={item.href}>{item.label}</a>
						</li>
					))
				}
			</ul>
			<div class="mobile-actions">
				<Button href={site.signupUrl} size="lg">{t.nav.signup}</Button>
				<Button href={site.loginUrl} variant="secondary" size="lg">{t.nav.login}</Button>
			</div>
		</nav>
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: rgb(246 244 239 / 0.82);
		backdrop-filter: saturate(1.4) blur(12px);
		-webkit-backdrop-filter: saturate(1.4) blur(12px);
		border-bottom: 1px solid transparent;
		transition: border-color var(--duration-fast) ease;
	}
	.site-header.is-scrolled,
	.site-header.is-open {
		border-bottom-color: var(--color-line);
	}
	.bar {
		display: flex;
		align-items: center;
		gap: var(--space-8);
		height: var(--header-height);
	}
	.home {
		display: inline-flex;
		border-radius: var(--radius-sm);
		text-decoration: none;
	}
	.nav {
		flex: 1;
	}
	.nav-list {
		display: flex;
		gap: var(--space-1);
	}
	.nav-list a {
		display: inline-block;
		padding: var(--space-2) var(--space-3);
		border-radius: var(--radius-sm);
		color: var(--color-ink-700);
		font-size: var(--text-sm);
		font-weight: 500;
		text-decoration: none;
		transition: color var(--duration-fast) ease;
	}
	.nav-list a:hover {
		color: var(--color-ink-950);
	}
	.actions {
		display: flex;
		align-items: center;
		gap: var(--space-2);
	}
	.menu-toggle {
		display: none;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		margin-right: calc(-1 * var(--space-2));
		border: 0;
		border-radius: var(--radius-sm);
		background: transparent;
		color: var(--color-ink-950);
		cursor: pointer;
	}
	.menu-toggle path {
		fill: none;
		stroke: currentColor;
		stroke-width: 1.6;
		stroke-linecap: round;
	}
	.icon-close,
	.is-open .icon-open {
		display: none;
	}
	.is-open .icon-close {
		display: block;
	}
	.mobile-menu {
		border-top: 1px solid var(--color-line);
		background: var(--color-paper);
		height: calc(100dvh - var(--header-height));
		overflow-y: auto;
	}
	.mobile-menu ul {
		padding-block: var(--space-2);
	}
	.mobile-menu li + li {
		border-top: 1px solid var(--color-line);
	}
	.mobile-menu li a {
		display: block;
		padding: var(--space-4) 0;
		font-size: var(--text-lg);
		font-weight: 500;
		text-decoration: none;
	}
	.mobile-actions {
		display: grid;
		gap: var(--space-3);
		padding-block: var(--space-4) var(--space-8);
	}

	@media (max-width: 56rem) {
		.nav,
		.actions :global(.login) {
			display: none;
		}
		.bar {
			justify-content: space-between;
		}
		.menu-toggle {
			display: grid;
		}
	}
	@media (max-width: 26rem) {
		.actions :global(.signup) {
			display: none;
		}
	}
	@media (min-width: 56.0625rem) {
		.mobile-menu {
			display: none;
		}
	}
</style>
