---
import { getContent } from "../../i18n";
import SectionHeader from "../ui/SectionHeader.astro";

const t = getContent();
const s = t.security;

// One line icon per item, in the order of `security.items`.
const icons = [
	"M8 14.5s4.5-4.2 4.5-8a4.5 4.5 0 0 0-9 0c0 3.8 4.5 8 4.5 8Zm0-6.5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3Z",
	"M4.5 7V5a3.5 3.5 0 0 1 7 0v2M3.5 7h9v7h-9z M8 9.5v2",
	"M2.5 5 8 2l5.5 3L8 8 2.5 5Zm0 3L8 11l5.5-3M2.5 11 8 14l5.5-3",
	"M4 1.5h5.5L13 5v9.5H4zM9 1.5v4h4M6.5 9.5l1.2 1.2 2.3-2.4",
	"M8 4.5V8l2.5 1.5M14 8A6 6 0 1 1 2 8a6 6 0 0 1 12 0Z",
	"M8 2v8m0 0-3-3m3 3 3-3M2.5 11v2.5h11V11",
];
---

<section id="sicherheit" class="section security" aria-labelledby="sicherheit-title">
	<div class="container">
		<SectionHeader id="sicherheit-title" eyebrow={s.eyebrow} title={s.title} lede={s.lede} tone="dark" />
		<ul class="items" role="list">
			{
				s.items.map((item, i) => (
					<li data-reveal>
						<svg viewBox="0 0 16 16" width="20" height="20" aria-hidden="true">
							<path d={icons[i]} />
						</svg>
						<h3>{item.title}</h3>
						<p>{item.text}</p>
					</li>
				))
			}
		</ul>
		<div class="disclosure">
			<p>{s.disclosure}</p>
			<a href="/datenschutz">{s.link}<span aria-hidden="true"> →</span></a>
		</div>
	</div>
</section>

<style>
	.security {
		background: var(--color-dark-bg);
		color: var(--color-dark-text);
	}
	.items {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		margin-top: var(--space-16);
		border-top: 1px solid var(--color-dark-line);
	}
	.items li {
		display: grid;
		align-content: start;
		gap: var(--space-3);
		padding: var(--space-8) var(--space-8) var(--space-10) 0;
		border-bottom: 1px solid var(--color-dark-line);
	}
	.items li:not(:nth-child(3n + 1)) {
		padding-left: var(--space-8);
		border-left: 1px solid var(--color-dark-line);
	}
	svg {
		margin-bottom: var(--space-2);
		fill: none;
		stroke: var(--color-accent-on-dark);
		stroke-width: 1.3;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	h3 {
		font-size: var(--text-lg);
		color: #fff;
	}
	.items p {
		color: var(--color-dark-muted);
		font-size: 0.9688rem;
	}
	.disclosure {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: var(--space-4) var(--space-8);
		margin-top: var(--space-10);
		color: var(--color-dark-muted);
		font-size: var(--text-sm);
	}
	.disclosure p {
		max-width: 44rem;
	}
	.disclosure a {
		color: var(--color-dark-text);
		font-weight: 500;
		text-underline-offset: 3px;
	}
	.security :global(:focus-visible) {
		outline-color: var(--color-accent-on-dark);
	}
	@media (max-width: 64rem) {
		.items {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
		.items li:not(:nth-child(3n + 1)) {
			padding-left: 0;
			border-left: 0;
		}
		.items li:nth-child(even) {
			padding-left: var(--space-8);
			border-left: 1px solid var(--color-dark-line);
		}
	}
	@media (max-width: 36rem) {
		.items {
			grid-template-columns: 1fr;
		}
		.items li:nth-child(even) {
			padding-left: 0;
			border-left: 0;
		}
		.items li {
			padding: var(--space-6) 0;
		}
	}
</style>
