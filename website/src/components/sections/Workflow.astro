---
import { getContent } from "../../i18n";
import StepVisual from "../product/StepVisual.astro";
import SectionHeader from "../ui/SectionHeader.astro";

const t = getContent();
const w = t.workflow;
---

<section id="ablauf" class="section workflow" aria-labelledby="ablauf-title">
	<div class="container">
		<SectionHeader id="ablauf-title" eyebrow={w.eyebrow} title={w.title} lede={w.lede} />

		<ol class="steps" role="list" data-steps>
			{
				w.steps.map((step, i) => (
					<li class="step" data-step data-reveal>
						<div class="copy">
							<span class="index num" aria-hidden="true">
								{String(i + 1).padStart(2, "0")}
							</span>
							<h3>{step.title}</h3>
							<p>{step.text}</p>
						</div>
						<div class="visual">
							<StepVisual kind={step.id as "rechnung" | "zahlung" | "belege" | "ueberblick" | "kanzlei"} />
						</div>
					</li>
				))
			}
		</ol>
	</div>
</section>

<style>
	.steps {
		position: relative;
		margin-top: var(--space-16);
		counter-reset: step;
	}
	/* The vertical rail connecting the step numbers. */
	.steps::before {
		content: "";
		position: absolute;
		top: 0.75rem;
		bottom: 0.75rem;
		left: 1.1875rem;
		border-left: 1px solid var(--color-line-strong);
	}
	.step {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
		gap: var(--space-8) var(--space-16);
		align-items: center;
		padding-block: var(--space-10);
	}
	.step + .step::before {
		content: "";
		position: absolute;
		top: 0;
		right: 0;
		left: 3.5rem;
		border-top: 1px solid var(--color-line);
	}
	.copy {
		position: relative;
		padding-left: 3.5rem;
	}
	.index {
		position: absolute;
		top: -0.1rem;
		left: 0;
		display: grid;
		place-items: center;
		width: 2.375rem;
		height: 2.375rem;
		border: 1px solid var(--color-line-strong);
		border-radius: 50%;
		background: var(--color-paper);
		color: var(--color-ink-500);
		font-size: var(--text-sm);
		font-weight: 600;
		transition:
			background-color var(--duration-base) var(--ease-out),
			border-color var(--duration-base) var(--ease-out),
			color var(--duration-base) var(--ease-out);
	}
	.step.is-active .index {
		border-color: var(--color-ink-950);
		background: var(--color-ink-950);
		color: #fff;
	}
	h3 {
		margin-bottom: var(--space-3);
		font-size: var(--text-xl);
		letter-spacing: var(--tracking-snug);
	}
	.copy p {
		max-width: 30rem;
		color: var(--color-ink-500);
	}
	.visual {
		display: flex;
		justify-content: center;
		padding: var(--space-8);
		border-radius: var(--radius-lg);
		background: var(--color-paper-deep);
	}
	@media (max-width: 56rem) {
		.step {
			grid-template-columns: 1fr;
		}
		/* Stacked steps: the rail would run behind the visuals. */
		.steps::before {
			display: none;
		}
		.visual {
			padding: var(--space-5);
		}
	}
	@media (max-width: 36rem) {
		.steps::before {
			left: 0.9375rem;
		}
		.step + .step::before {
			left: 2.75rem;
		}
		.copy {
			padding-left: 2.75rem;
		}
		.index {
			width: 1.875rem;
			height: 1.875rem;
			font-size: var(--text-xs);
		}
		.visual {
			padding: var(--space-4);
		}
	}
</style>
