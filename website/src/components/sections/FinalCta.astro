---
import { site } from "../../config/site";
import { getContent } from "../../i18n";
import Button from "../ui/Button.astro";

const t = getContent();
const c = t.finalCta;
---

<section class="final" aria-labelledby="final-title">
	<div class="container">
		<div class="inner" data-reveal>
			<div>
				<h2 id="final-title">{c.title}</h2>
				<p>{c.text}</p>
			</div>
			<div class="ctas">
				<Button href={site.signupUrl} variant="inverse" size="lg">{c.primary}</Button>
				<a class="contact" href={`mailto:${site.contactEmail}`}>{c.secondary}</a>
			</div>
		</div>
	</div>
</section>

<style>
	.final {
		padding-bottom: var(--space-section);
	}
	.inner {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		justify-content: space-between;
		gap: var(--space-10);
		padding: clamp(2.5rem, 1.5rem + 4vw, 4.5rem);
		border-radius: var(--radius-lg);
		background: var(--color-ink-950);
		color: var(--color-dark-text);
	}
	h2 {
		max-width: 34rem;
		font-size: var(--text-2xl);
		letter-spacing: var(--tracking-tight);
		line-height: 1.12;
		color: #fff;
	}
	p {
		margin-top: var(--space-4);
		color: var(--color-dark-muted);
		font-size: var(--text-lg);
	}
	.ctas {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-6);
	}
	.contact {
		color: #fff;
		font-size: var(--text-sm);
		font-weight: 500;
		text-underline-offset: 3px;
	}
	.final :global(:focus-visible) {
		outline-color: var(--color-accent-on-dark);
	}
</style>
