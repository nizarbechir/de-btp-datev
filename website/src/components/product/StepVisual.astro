---
import { formatMoney, getContent } from "../../i18n";
import StatusPill from "./StatusPill.astro";

interface Props {
	kind: "rechnung" | "zahlung" | "belege" | "ueberblick" | "kanzlei";
}
const { kind } = Astro.props;
const t = getContent();
const v = t.workflow.visuals;
const year = new Date().getFullYear();
const money = (value: number) => formatMoney(t.lang, value);
const net = v.invoice.lines.reduce((sum, line) => sum + line.amount, 0);
const vat = Math.round(net * 19) / 100;
type Tone = "good" | "warning" | "critical" | "neutral";
---

<div class="visual" aria-hidden="true">
	{
		kind === "rechnung" && (
			<div class="doc">
				<div class="doc-head">
					<div>
						<span class="caption">{v.invoice.label}</span>
						<strong class="num">{`RE-${year}-0142`}</strong>
					</div>
					<StatusPill tone="good">{v.invoice.status}</StatusPill>
				</div>
				<span class="muted">{v.invoice.customer}</span>
				<ul class="lines">
					{v.invoice.lines.map((line) => (
						<li>
							<span>{line.text}</span>
							<span class="num">{money(line.amount)}</span>
						</li>
					))}
				</ul>
				<dl class="totals">
					<div>
						<dt>{v.invoice.net}</dt>
						<dd class="num">{money(net)}</dd>
					</div>
					<div>
						<dt>{v.invoice.vat}</dt>
						<dd class="num">{money(vat)}</dd>
					</div>
					<div class="grand">
						<dt>{v.invoice.total}</dt>
						<dd class="num">{money(net + vat)}</dd>
					</div>
				</dl>
				<span class="tag">
					<svg viewBox="0 0 16 16" width="12" height="12">
						<path d="M4 1.5h5.5L13 5v9.5H4z M9 1.5V5.5h4" />
					</svg>
					{v.invoice.format}
				</span>
			</div>
		)
	}
	{
		kind === "zahlung" && (
			<div class="stack">
				<div class="card">
					<span class="caption">{v.match.label}</span>
					<div class="row">
						<span>{v.match.reference.replace("{year}", String(year))}</span>
						<strong class="num positive">+{money(net + vat)}</strong>
					</div>
				</div>
				<div class="connector">
					<span>{v.match.suggestion}</span>
				</div>
				<div class="card highlighted">
					<div class="row">
						<strong class="num">{`RE-${year}-0142`}</strong>
						<span class="num">{money(net + vat)}</span>
					</div>
					<div class="reasons">
						{v.match.reasons.map((reason) => (
							<span class="reason">
								<svg viewBox="0 0 16 16" width="11" height="11">
									<path d="m3.5 8.5 3 3 6-7" />
								</svg>
								{reason}
							</span>
						))}
					</div>
					<span class="fake-button">{v.match.confirm}</span>
				</div>
			</div>
		)
	}
	{
		kind === "belege" && (
			<div class="card">
				<span class="caption">{v.inbox.label}</span>
				<ul class="files">
					{v.inbox.files.map((file) => (
						<li>
							<span class="file-icon" />
							<span class="file-name">{file.name}</span>
							<StatusPill tone={file.tone as Tone}>{file.state}</StatusPill>
						</li>
					))}
				</ul>
			</div>
		)
	}
	{
		kind === "ueberblick" && (
			<div class="stack">
				<div class="kpi-pair">
					{t.app.kpis.slice(0, 2).map((kpi) => (
						<div class="card">
							<span class="caption">{kpi.label}</span>
							<strong class:list={["big num", kpi.tone === "critical" && "critical"]}>{money(kpi.value)}</strong>
						</div>
					))}
				</div>
				<div class="card">
					<span class="caption">{t.app.attention.title}</span>
					<ul class="attention">
						{t.app.attention.items.slice(0, 3).map((item) => (
							<li>
								<StatusPill tone={item.tone as Tone}>{item.count}</StatusPill>
								<span>{item.text}</span>
							</li>
						))}
					</ul>
				</div>
			</div>
		)
	}
	{
		kind === "kanzlei" && (
			<div class="card">
				<div class="row">
					<span class="caption">{v.export.label}</span>
					<span class="period num">{`${v.export.period} ${year}`}</span>
				</div>
				<ul class="checklist">
					{v.export.items.map((item) => (
						<li>
							<svg viewBox="0 0 16 16" width="12" height="12">
								<path d="m3.5 8.5 3 3 6-7" />
							</svg>
							{item}
						</li>
					))}
				</ul>
				<span class="fake-button dark">
					<svg viewBox="0 0 16 16" width="12" height="12">
						<path d="M8 2.5v8m0 0-3-3m3 3 3-3M3 13.5h10" />
					</svg>
					{v.export.action}
				</span>
			</div>
		)
	}
</div>

<style>
	.visual {
		width: 100%;
		max-width: 26rem;
		font-size: 0.875rem;
		line-height: 1.45;
		user-select: none;
	}
	.card,
	.doc {
		display: grid;
		gap: 0.75rem;
		padding: 1.125rem 1.25rem;
		border: 1px solid var(--color-line);
		border-radius: var(--radius-md);
		background: var(--color-surface);
		box-shadow: var(--shadow-sm);
	}
	.stack {
		display: grid;
		gap: 0.75rem;
	}
	.caption {
		display: block;
		color: var(--color-ink-500);
		font-size: 0.75rem;
	}
	.muted {
		color: var(--color-ink-500);
	}
	.row,
	.doc-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}
	.doc-head strong {
		font-size: 1rem;
	}
	.lines {
		margin: 0;
		padding: 0.25rem 0 0;
		list-style: none;
		border-top: 1px solid var(--color-line);
	}
	.lines li {
		display: flex;
		justify-content: space-between;
		padding: 0.5rem 0;
		border-bottom: 1px dashed var(--color-line);
	}
	.totals {
		display: grid;
		gap: 0.25rem;
		margin-left: auto;
		width: 60%;
	}
	.totals div {
		display: flex;
		justify-content: space-between;
		color: var(--color-ink-500);
	}
	.totals .grand {
		margin-top: 0.25rem;
		padding-top: 0.5rem;
		border-top: 1px solid var(--color-ink-950);
		color: var(--color-ink-950);
		font-weight: 650;
	}
	.tag {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
		justify-self: start;
		padding: 0.25rem 0.5rem;
		border-radius: 6px;
		background: var(--color-accent-soft);
		color: var(--color-accent-strong);
		font-size: 0.75rem;
		font-weight: 550;
	}
	svg {
		fill: none;
		stroke: currentColor;
		stroke-width: 1.6;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.positive {
		color: var(--color-good);
	}
	.connector {
		position: relative;
		display: flex;
		justify-content: center;
		height: 1.5rem;
	}
	.connector::before {
		content: "";
		position: absolute;
		top: -0.75rem;
		bottom: -0.75rem;
		left: 50%;
		border-left: 1px dashed var(--color-line-strong);
	}
	.connector span {
		position: relative;
		align-self: center;
		padding: 0 0.5rem;
		background: var(--color-paper);
		color: var(--color-accent);
		font-size: 0.75rem;
		font-weight: 600;
	}
	.highlighted {
		border-color: var(--color-accent);
		box-shadow: 0 0 0 3px var(--color-accent-soft);
	}
	.reasons {
		display: flex;
		flex-wrap: wrap;
		gap: 0.375rem;
	}
	.reason {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		padding: 0.125rem 0.5rem;
		border-radius: 999px;
		background: var(--color-paper);
		color: var(--color-ink-700);
		font-size: 0.75rem;
	}
	.reason svg {
		color: var(--color-accent);
	}
	.fake-button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.375rem;
		justify-self: start;
		padding: 0.375rem 0.875rem;
		border-radius: var(--radius-sm);
		background: var(--color-accent);
		color: #fff;
		font-size: 0.8125rem;
		font-weight: 550;
	}
	.fake-button.dark {
		background: var(--color-ink-950);
	}
	.files,
	.attention,
	.checklist {
		display: grid;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.files li {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr) auto;
		align-items: center;
		gap: 0.625rem;
		padding: 0.625rem 0;
		border-top: 1px solid var(--color-line);
	}
	.file-icon {
		width: 1.125rem;
		height: 1.375rem;
		border: 1.5px solid var(--color-ink-400);
		border-radius: 3px;
	}
	.file-name {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.kpi-pair {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0.75rem;
	}
	.big {
		font-size: 1.125rem;
		font-weight: 600;
		letter-spacing: -0.02em;
		white-space: nowrap;
	}
	.critical {
		color: var(--color-critical);
	}
	.attention li {
		display: flex;
		align-items: center;
		gap: 0.625rem;
		padding: 0.5rem 0;
		border-top: 1px solid var(--color-line);
		color: var(--color-ink-700);
	}
	.period {
		color: var(--color-ink-700);
		font-weight: 600;
	}
	.checklist li {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.5rem 0;
		border-top: 1px solid var(--color-line);
	}
	.checklist svg {
		color: var(--color-accent);
	}
</style>
