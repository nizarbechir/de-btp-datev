---
import { formatMoney, getContent } from "../../i18n";

const t = getContent();
const c = t.app.cashflow;
const width = 560;
const height = 130;
const max = Math.max(...c.incomeValues, ...c.expenseValues) * 1.1;
const slot = width / c.months.length;
const barWidth = 14;
const gap = 2;
const radius = 3;

/** A bar with rounded top corners, anchored to the baseline. */
function bar(x: number, value: number) {
	const h = (value / max) * height;
	const y = height - h;
	return `M${x},${height}V${y + radius}Q${x},${y} ${x + radius},${y}H${x + barWidth - radius}Q${x + barWidth},${y} ${x + barWidth},${y + radius}V${height}Z`;
}
---

<div class="chart">
	<div class="head">
		<span class="title">{c.title}</span>
		<span class="legend">
			<span><i class="swatch s1"></i>{c.income}</span>
			<span><i class="swatch s2"></i>{c.expenses}</span>
		</span>
	</div>
	<svg viewBox={`0 -4 ${width} ${height + 28}`} class="plot">
		{[0.25, 0.5, 0.75].map((f) => <line x1="0" x2={width} y1={height * f} y2={height * f} class="grid" />)}
		<line x1="0" x2={width} y1={height} y2={height} class="axis" />
		{
			c.months.map((month, i) => {
				const center = slot * i + slot / 2;
				const x1 = center - barWidth - gap / 2;
				const x2 = center + gap / 2;
				return (
					<g>
						<path d={bar(x1, c.incomeValues[i] ?? 0)} class="s1">
							<title>{`${month}: ${c.income} ${formatMoney(t.lang, c.incomeValues[i] ?? 0, 0)}`}</title>
						</path>
						<path d={bar(x2, c.expenseValues[i] ?? 0)} class="s2">
							<title>{`${month}: ${c.expenses} ${formatMoney(t.lang, c.expenseValues[i] ?? 0, 0)}`}</title>
						</path>
						<text x={center} y={height + 20} class="label">
							{month}
						</text>
					</g>
				);
			})
		}
	</svg>
</div>

<style>
	.chart {
		display: grid;
		gap: 0.75rem;
	}
	.head {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.5rem;
	}
	.title {
		font-weight: 600;
	}
	.legend {
		display: inline-flex;
		gap: 0.875rem;
		color: var(--color-ink-500);
		font-size: 0.6875rem;
	}
	.legend span {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
	}
	.swatch {
		width: 8px;
		height: 8px;
		border-radius: 2px;
	}
	.swatch.s1 {
		background: var(--color-series-1);
	}
	.swatch.s2 {
		background: var(--color-series-2);
	}
	.plot {
		width: 100%;
		height: auto;
		overflow: visible;
	}
	path.s1 {
		fill: var(--color-series-1);
	}
	path.s2 {
		fill: var(--color-series-2);
	}
	path:hover {
		opacity: 0.85;
	}
	.grid {
		stroke: var(--color-line);
		stroke-dasharray: 2 3;
		vector-effect: non-scaling-stroke;
	}
	.axis {
		stroke: var(--color-line-strong);
		vector-effect: non-scaling-stroke;
	}
	.label {
		fill: var(--color-ink-500);
		font-size: 12px;
		text-anchor: middle;
	}
</style>
