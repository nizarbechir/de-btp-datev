---
interface Props {
	/** Use light text on dark backgrounds. */
	inverted?: boolean;
}
const { inverted = false } = Astro.props;
---

<span class:list={["logo", { inverted }]}>
	<svg class="mark" viewBox="0 0 28 28" width="28" height="28" aria-hidden="true" focusable="false">
		<rect width="28" height="28" rx="7" class="mark-bg"></rect>
		<rect x="7" y="9" width="11" height="3.2" rx="1.6" class="mark-top"></rect>
		<rect x="10" y="15.8" width="11" height="3.2" rx="1.6" class="mark-bottom"></rect>
	</svg>
	<span class="wordmark">Swiver</span>
</span>

<style>
	.logo {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		color: var(--color-ink-950);
	}
	.wordmark {
		font-size: 1.1875rem;
		font-weight: 650;
		letter-spacing: -0.03em;
	}
	.mark-bg {
		fill: var(--color-ink-950);
	}
	.mark-top {
		fill: var(--color-accent-on-dark);
	}
	.mark-bottom {
		fill: #ffffff;
	}
	.inverted {
		color: var(--color-dark-text);
	}
	.inverted .mark-bg {
		fill: #ffffff;
	}
	.inverted .mark-top {
		fill: var(--color-accent);
	}
	.inverted .mark-bottom {
		fill: var(--color-ink-950);
	}
</style>
