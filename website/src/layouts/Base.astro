---
import interLatin from "@fontsource-variable/inter/files/inter-latin-opsz-normal.woff2?url";
import interLatinExt from "@fontsource-variable/inter/files/inter-latin-ext-opsz-normal.woff2?url";

import { site } from "../config/site";
import { getContent } from "../i18n";
import "../styles/global.css";

interface Props {
	title?: string;
	description?: string;
	noindex?: boolean;
	/** JSON-LD objects for this page. */
	structuredData?: object[];
}

const t = getContent();
const { title = t.meta.title, description = t.meta.description, noindex = false, structuredData = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/\/index$/, "/"), Astro.site);
const ogImage = new URL("/og.png", Astro.site);

// Only the subsets German text needs; the browser picks one by unicode-range.
const fontFaces = [
	{ src: interLatin, range: "U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD" },
	{ src: interLatinExt, range: "U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF" },
]
	.map(
		(face) =>
			`@font-face{font-family:"Inter Variable";font-style:normal;font-display:swap;font-weight:100 900;src:url(${face.src}) format("woff2-variations");unicode-range:${face.range}}`,
	)
	.join("");
---

<!doctype html>
<html lang={t.lang} dir="ltr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		{noindex && <meta name="robots" content="noindex, follow" />}

		<link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
		<style is:inline set:html={fontFaces} />

		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="theme-color" content="#f6f4ef" />
		<link rel="sitemap" href="/sitemap-index.xml" />

		<meta property="og:type" content="website" />
		<meta property="og:locale" content="de_DE" />
		<meta property="og:site_name" content={site.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={t.meta.ogImageAlt} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		{structuredData.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
		<script is:inline>document.documentElement.classList.add("js");</script>
	</head>
	<body>
		<a class="skip-link" href="#inhalt">{t.a11y.skipToContent}</a>
		<slot />
	</body>
</html>
