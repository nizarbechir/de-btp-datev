<mvc:View
	xmlns:core="sap.ui.core"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns="sap.m"
	xmlns:f="sap.f"
	xmlns:form="sap.ui.layout.form"
	xmlns:l="sap.ui.layout"
	xmlns:macros="sap.fe.macros"
	controllerName="swiver.dashboard.ext.Dashboard"
>
	<f:DynamicPage id="dashboardPage" showFooter="false" class="sapUiNoContentPadding">
		<f:title>
			<f:DynamicPageTitle id="dashboardTitle">
				<f:heading>
					<Title id="dashboardHeading" text="{= ${view>/organizationName} || ${i18n>dashboardTitle} }" />
				</f:heading>
				<f:expandedContent>
					<Label id="dashboardSubtitle" text="{i18n>dashboardSubtitle}" />
				</f:expandedContent>
				<f:actions>
					<Button id="newInvoiceButton" text="{i18n>newSalesInvoice}" icon="sap-icon://add-document" type="Emphasized" press=".onNewSalesInvoice" visible="{view>/hasOrganization}" />
					<Button id="uploadReceiptButton" text="{i18n>uploadReceipt}" icon="sap-icon://upload" press=".onNavigate($event, 'Purchases-manage&amp;/IncomingDocuments')" visible="{view>/hasOrganization}" />
				</f:actions>
			</f:DynamicPageTitle>
		</f:title>
		<f:content>
			<VBox id="dashboardRoot">
				<!-- Onboarding: shown until the signed-in user belongs to an organization -->
				<VBox id="onboarding" class="sapUiSmallMargin" visible="{= ${view>/loaded} === true &amp;&amp; !${view>/hasOrganization} }">
					<Title id="onboardingTitle" text="{i18n>onboardingTitle}" titleStyle="H3" />
					<Text id="onboardingText" text="{i18n>onboardingText}" class="sapUiSmallMarginBottom" />
					<form:SimpleForm id="onboardingForm" editable="true" layout="ColumnLayout" maxWidth="40rem">
						<Label id="companyNameLabel" text="{i18n>companyName}" required="true" />
						<Input id="companyName" value="{onboarding>/companyName}" />
						<Label id="countryLabel" text="{i18n>country}" />
						<Input id="country" value="{onboarding>/country}" maxLength="3" />
						<Label id="currencyLabel" text="{i18n>currency}" />
						<Input id="currency" value="{onboarding>/currency}" maxLength="3" />
						<Label id="vatIdLabel" text="{i18n>vatId}" />
						<Input id="vatId" value="{onboarding>/vatId}" />
						<Label id="taxRateLabel" text="{i18n>defaultVatRate}" />
						<StepInput id="taxRate" value="{onboarding>/defaultTaxRate}" min="0" max="100" />
						<Label id="termLabel" text="{i18n>paymentTermDays}" />
						<StepInput id="term" value="{onboarding>/defaultPaymentTermDays}" min="0" max="365" />
						<Label id="prefixLabel" text="{i18n>invoicePrefix}" />
						<Input id="prefix" value="{onboarding>/invoicePrefix}" maxLength="10" />
					</form:SimpleForm>
					<Button id="createOrganization" text="{i18n>createOrganization}" type="Emphasized" press=".onCreateOrganization" />
				</VBox>

				<VBox id="dashboardContent" class="sapUiSmallMargin" visible="{view>/hasOrganization}" binding="{path: '/dashboard()', parameters: {$$groupId: '$auto'}}">
					<!-- Key figures: one row, the second line says what needs action -->
					<l:Grid id="kpiGrid" defaultSpan="XL3 L3 M6 S12" containerQuery="true" class="sapUiNoMargin">
						<GenericTile id="kpiToCollect" width="100%" header="{i18n>kpiToCollect}" press=".onNavigate($event, 'Sales-manage&amp;/SalesInvoices')">
							<TileContent id="kpiToCollectContent" footer="{parts: ['receivables/overdue/amount', 'currency'], formatter: '.formatOverdue'}" footerColor="Critical">
								<ObjectNumber id="kpiToCollectValue" class="sapMObjectNumberLarge" number="{receivables/outstanding/amount}" unit="{currency}" emphasized="true" />
							</TileContent>
						</GenericTile>
						<GenericTile id="kpiToPay" width="100%" header="{i18n>kpiToPay}" press=".onNavigate($event, 'Purchases-manage&amp;/SupplierInvoices')">
							<TileContent id="kpiToPayContent" footer="{parts: ['payables/dueNext7Days/amount', 'currency'], formatter: '.formatDueSoon'}" footerColor="Critical">
								<ObjectNumber id="kpiToPayValue" class="sapMObjectNumberLarge" number="{payables/open/amount}" unit="{currency}" emphasized="true" />
							</TileContent>
						</GenericTile>
						<GenericTile id="kpiProfit" width="100%" header="{i18n>kpiProfitThisMonth}" press=".onNavigate($event, 'Finance-manage&amp;/Reports')">
							<TileContent id="kpiProfitContent" footer="{parts: ['receivables/revenueThisMonth/amount', 'payables/expensesThisMonth/amount', 'currency'], formatter: '.formatProfitHint'}">
								<ObjectNumber id="kpiProfitValue" class="sapMObjectNumberLarge" number="{= ${receivables/revenueThisMonth/amount} - ${payables/expensesThisMonth/amount} }" unit="{currency}" state="{= ${receivables/revenueThisMonth/amount} &lt; ${payables/expensesThisMonth/amount} ? 'Error' : 'Success' }" emphasized="true" />
							</TileContent>
						</GenericTile>
						<GenericTile id="kpiVat" width="100%" header="{i18n>kpiEstimatedVat}" press=".onNavigate($event, 'Finance-manage&amp;/Reports')">
							<TileContent id="kpiVatContent" footer="{i18n>kpiEstimatedVatSub}">
								<ObjectNumber id="kpiVatValue" class="sapMObjectNumberLarge" number="{estimatedVat}" unit="{currency}" emphasized="true" />
							</TileContent>
						</GenericTile>
					</l:Grid>

					<!-- What to do next, and how money moved -->
					<l:Grid id="workGrid" containerQuery="true" class="sapUiNoMargin sapUiSmallMarginTop">
						<List id="attentionList" headerText="{i18n>toDo}" items="{path: 'needsAttention', templateShareable: false}" noDataText="{i18n>nothingToDo}">
							<layoutData><l:GridData id="attentionSpan" span="XL5 L5 M12 S12" /></layoutData>
							<StandardListItem id="attentionItem" title="{text}" icon="sap-icon://alert" type="Navigation" press=".onAttention" />
						</List>
						<macros:Chart id="cashFlowChart" contextPath="/CashFlow" metaPath="@com.sap.vocabularies.UI.v1.Chart" header="{i18n>cashFlow}" personalization="Type" height="20rem">
							<macros:layoutData><l:GridData id="chartSpan" span="XL7 L7 M12 S12" /></macros:layoutData>
						</macros:Chart>
					</l:Grid>

					<!-- Open invoices, money in and money out in one place -->
					<IconTabBar id="openItemsTabs" class="sapUiSmallMarginTop sapUiResponsiveContentPadding" expandable="false" headerBackgroundDesign="Transparent">
						<items>
							<IconTabFilter id="moneyInTab" text="{i18n>moneyIn}" count="{receivables/outstanding/count}">
								<macros:Table
									id="openSalesInvoices"
									contextPath="/SalesInvoices"
									metaPath="@com.sap.vocabularies.UI.v1.SelectionPresentationVariant#Receivables"
									type="ResponsiveTable"
									personalization="false"
									variantManagement="None"
									width="100%"
								/>
							</IconTabFilter>
							<IconTabFilter id="moneyOutTab" text="{i18n>moneyOut}" count="{payables/open/count}">
								<macros:Table
									id="upcomingPayments"
									contextPath="/SupplierInvoices"
									metaPath="@com.sap.vocabularies.UI.v1.SelectionPresentationVariant#Upcoming"
									type="ResponsiveTable"
									personalization="false"
									variantManagement="None"
									width="100%"
								/>
							</IconTabFilter>
						</items>
					</IconTabBar>
				</VBox>
			</VBox>
		</f:content>
	</f:DynamicPage>
</mvc:View>
