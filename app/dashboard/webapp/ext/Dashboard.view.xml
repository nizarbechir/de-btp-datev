<mvc:View
	xmlns:core="sap.ui.core"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns="sap.m"
	xmlns:f="sap.f"
	xmlns:form="sap.ui.layout.form"
	xmlns:grid="sap.ui.layout.cssgrid"
	xmlns:macros="sap.fe.macros"
	controllerName="swiver.dashboard.ext.Dashboard"
>
	<f:DynamicPage id="dashboardPage" showFooter="false" class="sapUiNoContentPadding">
		<f:title>
			<f:DynamicPageTitle id="dashboardTitle">
				<f:heading>
					<Title id="dashboardHeading" text="{= ${view>/organizationName} || ${i18n>dashboardTitle} }" />
				</f:heading>
				<f:expandedContent>
					<Label id="dashboardSubtitle" text="{i18n>dashboardSubtitle}" />
				</f:expandedContent>
				<f:actions>
					<Button id="newInvoiceButton" text="{i18n>newSalesInvoice}" icon="sap-icon://add-document" type="Emphasized" press=".onNewSalesInvoice" visible="{view>/hasOrganization}" />
					<Button id="uploadReceiptButton" text="{i18n>uploadReceipt}" icon="sap-icon://upload" press=".onNavigate($event, 'Purchases-manage&amp;/IncomingDocuments')" visible="{view>/hasOrganization}" />
				</f:actions>
			</f:DynamicPageTitle>
		</f:title>
		<f:content>
			<VBox id="dashboardRoot">
				<!-- Onboarding: shown until the signed-in user belongs to an organization -->
				<VBox id="onboarding" class="sapUiSmallMargin" visible="{= ${view>/loaded} === true &amp;&amp; !${view>/hasOrganization} }">
					<Title id="onboardingTitle" text="{i18n>onboardingTitle}" titleStyle="H3" />
					<Text id="onboardingText" text="{i18n>onboardingText}" class="sapUiSmallMarginBottom" />
					<form:SimpleForm id="onboardingForm" editable="true" layout="ColumnLayout" maxWidth="40rem">
						<Label id="companyNameLabel" text="{i18n>companyName}" required="true" />
						<Input id="companyName" value="{onboarding>/companyName}" />
						<Label id="countryLabel" text="{i18n>country}" />
						<Input id="country" value="{onboarding>/country}" maxLength="3" />
						<Label id="currencyLabel" text="{i18n>currency}" />
						<Input id="currency" value="{onboarding>/currency}" maxLength="3" />
						<Label id="vatIdLabel" text="{i18n>vatId}" />
						<Input id="vatId" value="{onboarding>/vatId}" />
						<Label id="taxRateLabel" text="{i18n>defaultVatRate}" />
						<StepInput id="taxRate" value="{onboarding>/defaultTaxRate}" min="0" max="100" />
						<Label id="termLabel" text="{i18n>paymentTermDays}" />
						<StepInput id="term" value="{onboarding>/defaultPaymentTermDays}" min="0" max="365" />
						<Label id="prefixLabel" text="{i18n>invoicePrefix}" />
						<Input id="prefix" value="{onboarding>/invoicePrefix}" maxLength="10" />
					</form:SimpleForm>
					<Button id="createOrganization" text="{i18n>createOrganization}" type="Emphasized" press=".onCreateOrganization" />
				</VBox>

				<!-- One grid: every widget sits in a card that fills its cell, so rows always line up -->
				<VBox id="dashboardContent" class="sapUiContentPadding" visible="{view>/hasOrganization}">
					<!-- Key figures: as many equal columns as fit, at least 14rem each -->
					<grid:CSSGrid id="kpiGrid" gridTemplateColumns="repeat(auto-fit, minmax(14rem, 1fr))" gridGap="1rem">
						<GenericTile id="kpiToCollect" width="100%" header="{i18n>kpiToCollect}" press=".onNavigate($event, 'Sales-manage&amp;/SalesInvoices')">
							<TileContent id="kpiToCollectContent" footer="{parts: [{path: 'kpi>/receivables/overdue/amount'}, 'kpi>/currency'], formatter: '.formatOverdue'}" footerColor="Critical">
								<ObjectNumber id="kpiToCollectValue" class="sapMObjectNumberLarge" number="{path: 'kpi>/receivables/outstanding/amount', formatter: '.formatAmount'}" unit="{kpi>/currency}" emphasized="true" />
							</TileContent>
						</GenericTile>
						<GenericTile id="kpiToPay" width="100%" header="{i18n>kpiToPay}" press=".onNavigate($event, 'Purchases-manage&amp;/SupplierInvoices')">
							<TileContent id="kpiToPayContent" footer="{parts: [{path: 'kpi>/payables/dueNext7Days/amount'}, 'kpi>/currency'], formatter: '.formatDueSoon'}" footerColor="Critical">
								<ObjectNumber id="kpiToPayValue" class="sapMObjectNumberLarge" number="{path: 'kpi>/payables/open/amount', formatter: '.formatAmount'}" unit="{kpi>/currency}" emphasized="true" />
							</TileContent>
						</GenericTile>
						<GenericTile id="kpiProfit" width="100%" header="{i18n>kpiProfitThisMonth}" press=".onNavigate($event, 'Finance-manage&amp;/Reports')">
							<TileContent id="kpiProfitContent" footer="{parts: [{path: 'kpi>/receivables/revenueThisMonth/amount'}, {path: 'kpi>/payables/expensesThisMonth/amount'}, 'kpi>/currency'], formatter: '.formatProfitHint'}">
								<ObjectNumber id="kpiProfitValue" class="sapMObjectNumberLarge" number="{path: 'kpi>/profitThisMonth', formatter: '.formatAmount'}" unit="{kpi>/currency}" state="{= ${kpi>/profitThisMonth} &lt; 0 ? 'Error' : 'Success' }" emphasized="true" />
							</TileContent>
						</GenericTile>
						<GenericTile id="kpiVat" width="100%" header="{i18n>kpiEstimatedVat}" press=".onNavigate($event, 'Finance-manage&amp;/Reports')">
							<TileContent id="kpiVatContent" footer="{i18n>kpiEstimatedVatSub}">
								<ObjectNumber id="kpiVatValue" class="sapMObjectNumberLarge" number="{path: 'kpi>/estimatedVat', formatter: '.formatAmount'}" unit="{kpi>/currency}" emphasized="true" />
							</TileContent>
						</GenericTile>
					</grid:CSSGrid>

					<!-- To do and cash flow: two equal-height cards side by side, stacked when narrow -->
					<grid:CSSGrid id="workGrid" gridTemplateColumns="repeat(auto-fit, minmax(24rem, 1fr))" gridGap="1rem" class="sapUiSmallMarginTop">
						<f:Card id="attentionCard" height="100%">
							<f:content>
								<List id="attentionList" items="{kpi>/needsAttention}" noDataText="{i18n>nothingToDo}" showSeparators="Inner">
									<headerToolbar>
										<Toolbar id="attentionToolbar" style="Clear">
											<Title id="attentionTitle" text="{i18n>toDo}" titleStyle="H4" />
										</Toolbar>
									</headerToolbar>
									<StandardListItem id="attentionItem" title="{kpi>text}" icon="sap-icon://alert" type="Navigation" press=".onAttention" />
								</List>
							</f:content>
						</f:Card>
						<f:Card id="cashFlowCard" height="100%">
							<f:content>
								<macros:Chart id="cashFlowChart" contextPath="/CashFlow" metaPath="@com.sap.vocabularies.UI.v1.Chart" header="{i18n>cashFlow}" personalization="Type" width="100%" height="22rem" />
							</f:content>
						</f:Card>
					</grid:CSSGrid>

					<!-- Open invoices, money in and money out in one full-width card -->
					<f:Card id="openItemsCard" class="sapUiSmallMarginTop">
						<f:content>
						<IconTabBar id="openItemsTabs" expandable="false" applyContentPadding="false" headerBackgroundDesign="Transparent">
							<items>
								<IconTabFilter id="moneyInTab" text="{i18n>moneyIn}" count="{kpi>/receivables/outstanding/count}">
									<macros:Table
										id="openSalesInvoices"
										contextPath="/SalesInvoices"
										metaPath="@com.sap.vocabularies.UI.v1.SelectionPresentationVariant#Receivables"
										type="ResponsiveTable"
										personalization="false"
										variantManagement="None"
										width="100%"
									/>
								</IconTabFilter>
								<IconTabFilter id="moneyOutTab" text="{i18n>moneyOut}" count="{kpi>/payables/open/count}">
									<macros:Table
										id="upcomingPayments"
										contextPath="/SupplierInvoices"
										metaPath="@com.sap.vocabularies.UI.v1.SelectionPresentationVariant#Upcoming"
										type="ResponsiveTable"
										personalization="false"
										variantManagement="None"
										width="100%"
									/>
								</IconTabFilter>
							</items>
						</IconTabBar>
						</f:content>
					</f:Card>
				</VBox>
			</VBox>
		</f:content>
	</f:DynamicPage>
</mvc:View>
