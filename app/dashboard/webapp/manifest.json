{
	"_version": "1.65.0",
	"sap.app": {
		"id": "swiver.dashboard",
		"type": "application",
		"i18n": "i18n/i18n.properties",
		"applicationVersion": {
			"version": "0.0.1"
		},
		"title": "{{appTitle}}",
		"description": "{{appDescription}}",
		"resources": "resources.json",
		"sourceTemplate": {
			"id": "@sap/generator-fiori:lrop",
			"version": "1.17.1"
		},
		"dataSources": {
			"mainService": {
				"uri": "odata/v4/finance/",
				"type": "OData",
				"settings": {
					"annotations": [],
					"odataVersion": "4.0"
				}
			},
			"organizationService": {
				"uri": "odata/v4/organization/",
				"type": "OData",
				"settings": {
					"annotations": [],
					"odataVersion": "4.0"
				}
			},
			"salesService": {
				"uri": "odata/v4/sales/",
				"type": "OData",
				"settings": {
					"annotations": [],
					"odataVersion": "4.0"
				}
			}
		},
		"crossNavigation": {
			"inbounds": {
				"Dashboard-display": {
					"semanticObject": "Dashboard",
					"action": "display",
					"title": "{{flpTitle}}",
					"subTitle": "{{flpSubtitle}}",
					"icon": "sap-icon://home",
					"signature": {
						"parameters": {},
						"additionalParameters": "allowed"
					}
				}
			},
			"outbounds": {
				"salesInvoice": {
					"semanticObject": "Sales",
					"action": "manage",
					"parameters": {}
				},
				"supplierInvoice": {
					"semanticObject": "Purchases",
					"action": "manage",
					"parameters": {}
				}
			}
		}
	},
	"sap.ui": {
		"technology": "UI5",
		"icons": {
			"icon": "",
			"favIcon": "",
			"phone": "",
			"phone@2": "",
			"tablet": "",
			"tablet@2": ""
		},
		"deviceTypes": {
			"desktop": true,
			"tablet": true,
			"phone": true
		}
	},
	"sap.ui5": {
		"flexEnabled": true,
		"dependencies": {
			"minUI5Version": "1.148.4",
			"libs": {
				"sap.m": {},
				"sap.ui.core": {},
				"sap.fe.templates": {},
				"sap.fe.macros": {},
				"sap.f": {},
				"sap.ui.layout": {},
				"sap.viz": {
					"lazy": true
				}
			}
		},
		"contentDensities": {
			"compact": true,
			"cozy": true
		},
		"models": {
			"i18n": {
				"type": "sap.ui.model.resource.ResourceModel",
				"settings": {
					"bundleName": "swiver.dashboard.i18n.i18n"
				}
			},
			"": {
				"dataSource": "mainService",
				"preload": true,
				"settings": {
					"operationMode": "Server",
					"autoExpandSelect": true,
					"earlyRequests": true
				}
			},
			"@i18n": {
				"type": "sap.ui.model.resource.ResourceModel",
				"uri": "i18n/i18n.properties"
			},
			"org": {
				"dataSource": "organizationService",
				"preload": true,
				"settings": {
					"operationMode": "Server",
					"autoExpandSelect": true
				}
			},
			"sales": {
				"dataSource": "salesService",
				"preload": false,
				"settings": {
					"operationMode": "Server",
					"autoExpandSelect": true
				}
			}
		},
		"resources": {
			"css": [
				{
					"uri": "css/style.css"
				}
			]
		},
		"routing": {
			"config": {},
			"routes": [
				{
					"pattern": ":?query:",
					"name": "Dashboard",
					"target": "Dashboard"
				}
			],
			"targets": {
				"Dashboard": {
					"type": "Component",
					"id": "Dashboard",
					"name": "sap.fe.core.fpm",
					"options": {
						"settings": {
							"viewName": "swiver.dashboard.ext.Dashboard",
							"contextPath": "/SalesInvoices",
							"navigation": {
								"SupplierInvoices": {
									"detail": {
										"outbound": "supplierInvoice"
									}
								},
								"SalesInvoices": {
									"detail": {
										"outbound": "salesInvoice"
									}
								}
							}
						}
					}
				}
			}
		}
	},
	"sap.fiori": {
		"registrationIds": [],
		"archeType": "transactional"
	},
	"sap.cloud": {
		"public": true,
		"service": "swiver.service"
	},
	"sap.platform.cf": {
		"ui5VersionNumber": "1.148.4"
	}
}
