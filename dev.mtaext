_schema-version: "3.1"
ID: swiver-dev
extends: swiver

modules:
- name: swiver-srv
  requires:
  - name: swiver-autoscaler
    parameters:
      config:
        instance_min_count: 1
        instance_max_count: 2
        scaling_rules:
        - metric_type: cpuutil
          threshold: 60
          operator: ">"
          breach_duration_secs: 60
          cool_down_secs: 120
          adjustment: "+1"
        - metric_type: cpuutil
          threshold: 30
          operator: "<"
          breach_duration_secs: 120
          cool_down_secs: 120
          adjustment: "-1"
        - metric_type: memoryutil
          threshold: 65
          operator: ">"
          breach_duration_secs: 60
          cool_down_secs: 120
          adjustment: "+1"
        - metric_type: memoryutil
          threshold: 35
          operator: "<"
          breach_duration_secs: 120
          cool_down_secs: 120
          adjustment: "-1"
        - metric_type: diskutil
          threshold: 70
          operator: ">"
          breach_duration_secs: 60
          cool_down_secs: 120
          adjustment: "+1"
        - metric_type: diskutil
          threshold: 40
          operator: "<"
          breach_duration_secs: 120
          cool_down_secs: 120
          adjustment: "-1"
        - metric_type: responsetime
          threshold: 800
          operator: ">"
          breach_duration_secs: 60
          cool_down_secs: 120
          adjustment: "+1"
        - metric_type: responsetime
          threshold: 400
          operator: "<"
          breach_duration_secs: 120
          cool_down_secs: 120
          adjustment: "-1"
        - metric_type: throughput
          threshold: 40
          operator: ">"
          breach_duration_secs: 60
          cool_down_secs: 120
          adjustment: "+1"
        - metric_type: throughput
          threshold: 15
          operator: "<"
          breach_duration_secs: 120
          cool_down_secs: 120
          adjustment: "-1"