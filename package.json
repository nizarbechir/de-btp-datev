{
	"name": "swiver",
	"version": "1.0.0",
	"private": true,
	"description": "Swiver: track supplier invoices, what is paid, what is open and what is due soon.",
	"type": "commonjs",
	"imports": {
		"#cds-models/*": "./@cds-models/*/index.js"
	},
	"workspaces": [
		"app/*"
	],
	"scripts": {
		"bind-to-services": "./scripts/bind-to-services.sh",
		"build": "rimraf resources mta_archives && mbt build --mtar archive",
		"build:dev": "rimraf resources mta_archives gen && mbt build --extensions dev.mtaext --mtar archive",
		"build:models": "npx @cap-js/cds-typer '*' --outputDirectory @cds-models",
		"build:prd": "rimraf resources mta_archives gen && mbt build --extensions prd.mtaext --mtar archive",
		"build:prd-hotfix": "rimraf resources mta_archives gen && mbt build --extensions prd-hotfix.mtaext --mtar archive",
		"build:qas": "rimraf resources mta_archives gen && mbt build --extensions qas.mtaext --mtar archive",
		"build:rse": "rimraf resources mta_archives gen && mbt build --extensions rse.mtaext --mtar archive",
		"deploy": "cf deploy mta_archives/archive.mtar --retries 1 -f --version-rule ALL",
		"deploy:db": "./scripts/deploy-db.sh",
		"format": "prettier --write \"**/*.{js,ts,json,sh,md,yml}\"",
		"hybrid": "cds watch --profile hybrid",
		"install:check": "bash ./scripts/npm-install-safe.sh check",
		"install:safe": "bash ./scripts/npm-install-safe.sh install",
		"killport": "kill-port --port 4004",
		"lint": "npx eslint . --max-warnings 0 --report-unused-disable-directives",
		"lint:fix": "npm run lint -- --fix",
		"lint:spelling": "cspell \"**\" \".github/**/*\"",
		"prepare": "node -e \"if (process.env.NODE_ENV !== 'production'){process.exit(1)} \" || husky",
		"setup": "npm i && npm run bind-to-services",
		"start": "cds-serve",
		"test": "jest test/unit --watch",
		"test:ci": "jest test/unit",
		"test:integration": "jest test/integration --runInBand --no-cache",
		"undeploy": "cf undeploy swiver --delete-services --delete-service-keys --delete-service-brokers",
		"watch": "npm run killport && cds-ts watch",
		"watch-hybrid": "cds-ts watch --profile hybrid",
		"watch-swiver": "cds-ts watch --open launchpad.html?sap-ui-xx-viewCache=false --livereload false"
	},
	"lint-staged": {
		"**/*.{js,ts,json,sh,md,yml}": [
			"prettier --ignore-unknown --write",
			"eslint --max-warnings 0 --report-unused-disable-directives --fix --no-warn-ignored"
		],
		"**/*.cds": [
			"eslint --max-warnings 0 --report-unused-disable-directives --fix --no-warn-ignored"
		]
	},
	"dependencies": {
		"@cap-js/change-tracking": "~2.0.1",
		"@cap-js/hana": "^3.0.1",
		"@sap-cloud-sdk/openapi": "~4.7.0",
		"@sap/cds": "~10.0.3",
		"@sap/xssec": "^4",
		"dejavu-fonts-ttf": "^2.37.3",
		"fast-xml-parser": "^5.11.1",
		"fflate": "^0.8.3",
		"pdf-lib": "^1.17.1",
		"pdfkit": "^0.20.2"
	},
	"devDependencies": {
		"@cap-js/cds-test": "^1.0.1",
		"@cap-js/cds-typer": "^0.40.0",
		"@cap-js/cds-types": "^0.18.0",
		"@cap-js/sqlite": "3.0.2",
		"@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
		"@eslint/js": "^10.0.1",
		"@jest/globals": "^30.4.1",
		"@prettier/plugin-xml": "^3.4.2",
		"@sap/cds-dk": "^10.0.4",
		"@sap/eslint-plugin-cds": "^4",
		"@sapui5/types": "^1.150.0",
		"@semantic-release/exec": "^7.1.0",
		"@semantic-release/git": "^10.0.1",
		"@semantic-release/github": "^12.0.9",
		"@types/eslint-plugin-markdown": "^2.0.2",
		"@types/node": "^26.1.1",
		"@types/pdfkit": "^0.17.6",
		"cds-plugin-ui5": "^0.17.4",
		"cds-swagger-ui-express": "^0.11.0",
		"cspell": "^10.0.1",
		"eslint": "^10.6.0",
		"eslint-plugin-jest": "^29.15.4",
		"eslint-plugin-jsdoc": "^63.0.13",
		"eslint-plugin-jsonc": "^3.3.0",
		"eslint-plugin-markdown": "^5.1.0",
		"eslint-plugin-n": "^18.2.1",
		"eslint-plugin-package-json": "^1.5.0",
		"eslint-plugin-perfectionist": "^5.10.0",
		"eslint-plugin-regexp": "^3.1.1",
		"eslint-plugin-yml": "^3.6.0",
		"husky": "^9.1.7",
		"jest": "^30.4.2",
		"jsonc-eslint-parser": "^3.1.0",
		"kill-port": "^2.0.1",
		"lint-staged": "^17.0.8",
		"mbt": "1.2.49",
		"prettier": "^3.9.5",
		"prettier-plugin-curly": "^0.4.1",
		"prettier-plugin-packagejson": "^3.0.2",
		"prettier-plugin-sh": "^0.19.0",
		"rimraf": "^6.1.3",
		"semantic-release": "^25.0.5",
		"semantic-release-export-data": "^1.2.0",
		"sqlite3": "^6.0.1",
		"ts-jest": "^29.4.11",
		"ts-node": "^10.9.2",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.63.0",
		"ui5-task-zipper": "^3.6.1",
		"ui5-tooling-transpile": "^3.11.3"
	},
	"engines": {
		"node": "^24.15",
		"npm": "^11.12"
	},
	"sapux": [
		"app/dashboard",
		"app/sales",
		"app/purchases",
		"app/finance",
		"app/settings",
		"app/customers",
		"app/products",
		"app/suppliers",
		"app/expensecategories"
	]
}
