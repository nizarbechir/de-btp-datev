  "version": "0.2.0",
  "configurations": [
    {
      "command": "npm run watch",
      "type": "node-terminal",
      "request": "launch",
      "name": "watch",
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "command": "npm run test",
      "type": "node-terminal",
      "request": "launch",
      "name": "unit test",
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "command": "npm run test:integration",
      "type": "node-terminal",
      "request": "launch",
      "name": "integration tests",
      "skipFiles": [
        "<node_internals>/**"
      ]
    }
  ]
}