# ============================================================
# npm Supply Chain Security Configuration
# Requires: npm >= 11.10.0
# ============================================================

# Defense: Reject any package version published less than 7 days ago.
# This blocks the typical attack window (hours to a few days) for
# malicious package versions before they are detected and removed.
min-release-age=7

# Enforce exact versions from lockfile — no surprise upgrades.
package-lock=true

# Fail npm commands if the current Node.js version does not satisfy
# the engines.node field in package.json. Ensures CI always runs on
# the required Node version rather than silently continuing.
engine-strict=true

# Prevent execution of arbitrary lifecycle scripts during install.
# Individual trusted packages can be allowed via install-links or
# the allow-scripts list below.
# ignore-scripts=true
