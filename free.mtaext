_schema-version: "3.1"
ID: swiver-free
extends: swiver

# Dev/test deployment with free-tier services only (eu22):
# no autoscaler, no Cloud Logging, one small backend instance.
modules:
- name: swiver-srv
  parameters:
    memory: 512M
    disk-quota: 512M
    instances: 1
- name: swiver-db-deployer
  parameters:
    memory: 256M
    disk-quota: 512M
- name: swiver-destination-content
  parameters:
    content:
      subaccount:
        destinations:
        - Name: wz-swiver-cdm-dt
          ServiceInstanceName: swiver-html5-rt
          ServiceKeyName: swiver-html5-rt-key
          URL: https://html5-apps-repo-rt.cfapps.eu22.hana.ondemand.com/applications/cdm/swiverservice
        existing_destinations_policy: update

resources:
- name: swiver-autoscaler
  active: false
- name: swiver-cls
  active: false
